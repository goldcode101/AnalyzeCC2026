@model List<CreditCardAnalyzer.Models.CategoryRule>

<div class="analysis-heading">
    <div>
        <p class="eyebrow mb-1">Configuration</p>
        <h1 class="mb-0">Category settings</h1>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Analysis" asp-action="Index">Back to analysis</a>
</div>

<section class="analysis-section">
    <div class="section-heading">
        <div>
            <p class="eyebrow mb-1">Custom categorization</p>
            <h2>Merchant rules</h2>
        </div>
        <span class="text-muted small">@Model.Count rules configured</span>
    </div>

    <p class="text-muted">Transactions are assigned to the first category rule whose keyword appears in the merchant description.</p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-light border mb-0">No custom category rules are configured.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Merchant keywords</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rule in Model)
                    {
                        <tr>
                            <th>@rule.Name</th>
                            <td>
                                <div class="keyword-list">
                                    @foreach (var keyword in rule.Keywords)
                                    {
                                        <span class="keyword-chip">@keyword</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<div class="alert alert-info mt-4">
    To change these rules, update the <code>CustomCategoryRules</code> section in <code>appsettings.json</code> and restart the application.
</div>
