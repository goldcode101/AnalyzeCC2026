@using System.Globalization
@using System.Text.Json
@model CreditCardAnalyzer.Models.AnalysisViewModel

@{
    var largestCategory = Model.Summary.ByCategory.OrderByDescending(x => x.Value.TotalSpent).FirstOrDefault();
    var highestMonth = Model.Summary.MonthlyTotals.OrderByDescending(x => x.Value.TotalSpent).FirstOrDefault();
    var averageMonthlySpend = Model.Summary.MonthlyTotals.Count == 0
        ? 0m
        : Model.Summary.TotalSpent / Model.Summary.MonthlyTotals.Count;
    var categories = Model.Summary.ByCategory.Keys.OrderBy(category => category).ToList();
    var merchants = Model.Summary.ByMerchant
        .OrderBy(merchant => merchant.Key, StringComparer.OrdinalIgnoreCase)
        .Select(merchant => merchant.Key)
        .ToList();
    var detailTransactions = Model.Transactions
        .Where(transaction => transaction.Debit > 0 || transaction.Credit > 0)
        .Select(transaction => new
        {
            Month = transaction.TransactionDate.ToString("yyyy-MM"),
            Category = transaction.EffectiveCategory,
            Date = transaction.TransactionDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture),
            Merchant = transaction.Description,
            Amount = transaction.NetAmount,
            IsRefund = transaction.Credit > 0,
            OriginalCategory = transaction.Category
        });
}

<div class="analysis-heading">
    <div>
        <p class="eyebrow mb-1">Spending overview</p>
        <h1 class="mb-0">Credit card analysis</h1>
    </div>
    <span class="analysis-period">@Model.Summary.MonthlyTotals.Count months tracked</span>
</div>

<div class="headline-strip mb-4">
    <div>
        <span>Total spent</span>
        <strong>@Model.Summary.TotalSpent.ToString("C")</strong>
    </div>
    <div>
        <span>Monthly average</span>
        <strong>@averageMonthlySpend.ToString("C")</strong>
    </div>
    <div>
        <span>Largest category</span>
        <strong>@(largestCategory.Key ?? "-")</strong>
    </div>
    <div>
        <span>Highest month</span>
        <strong>@(highestMonth.Key is null ? "-" : DateTime.ParseExact(highestMonth.Key, "yyyy-MM", CultureInfo.InvariantCulture).ToString("MMMM yyyy", CultureInfo.InvariantCulture))</strong>
    </div>
</div>

<section class="analysis-section mb-4">
    <div class="section-heading">
        <div>
            <p class="eyebrow mb-1">Monthly comparison</p>
            <h2>Spending by category each month</h2>
        </div>
        <span class="text-muted small">Select a value to inspect transactions</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table analysis-matrix mb-0">
                <thead>
                    <tr>
                        <th>Month</th>
                        @foreach (var category in categories)
                        {
                            <th class="text-end">@category</th>
                        }
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var month in Model.Summary.ByMonthAndCategory.OrderByDescending(month => month.Key))
                    {
                        <tr>
                            <th>@DateTime.ParseExact(month.Key, "yyyy-MM", CultureInfo.InvariantCulture).ToString("MMMM yyyy", CultureInfo.InvariantCulture)</th>
                            @foreach (var category in categories)
                            {
                                <td class="text-end matrix-value">
                                    @if (month.Value.TryGetValue(category, out var group))
                                    {
                                        <button class="matrix-button" type="button" data-detail-month="@month.Key" data-detail-category="@category" data-bs-toggle="offcanvas" data-bs-target="#transaction-detail" aria-label="View @category spending for @month.Key">
                                            @group.TotalSpent.ToString("C")
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            }
                            <th class="text-end">@Model.Summary.MonthlyTotals[month.Key].TotalSpent.ToString("C")</th>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

<section class="analysis-section merchant-explorer mb-4">
    <div class="section-heading">
        <div>
            <p class="eyebrow mb-1">Merchant detail</p>
            <h2>Explore merchants</h2>
        </div>
        <span class="text-muted small">Select a merchant to see its transactions</span>
    </div>
    <div class="merchant-layout">
        <div class="merchant-list" role="list" aria-label="Merchants">
            @foreach (var merchant in merchants)
            {
                var merchantGroup = Model.Summary.ByMerchant[merchant];
                <button class="merchant-item" type="button" data-merchant="@merchant" role="listitem" aria-label="View details for @merchant">
                    <span class="merchant-item-name">@merchant</span>
                    <span class="merchant-item-meta">@merchantGroup.Count transaction@(merchantGroup.Count == 1 ? "" : "s")</span>
                    <strong>@merchantGroup.TotalNet.ToString("C")</strong>
                </button>
            }
        </div>
        <div class="merchant-detail" id="merchant-detail" aria-live="polite">
            <div class="merchant-empty-state" id="merchant-empty-state">
                <p class="eyebrow mb-2">Merchant snapshot</p>
                <h3>Select a merchant</h3>
                <p class="text-muted mb-0">Choose a merchant to view monthly totals and every transaction.</p>
            </div>
            <div id="merchant-detail-content" hidden>
                <div class="merchant-detail-heading">
                    <div>
                        <p class="eyebrow mb-1">Selected merchant</p>
                        <h3 id="merchant-detail-name"></h3>
                    </div>
                    <div class="merchant-detail-total">
                        <span id="merchant-detail-count"></span>
                        <strong id="merchant-detail-total"></strong>
                    </div>
                </div>
                <div id="merchant-months" class="merchant-months"></div>
                <div>
                    <p class="eyebrow mb-2">Transactions</p>
                    <div id="merchant-detail-list" class="detail-list"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="accordion mb-4" id="supporting-analysis">
    <div class="accordion-item">
        <h2 class="accordion-header" id="supporting-analysis-heading">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#supporting-analysis-body" aria-expanded="false" aria-controls="supporting-analysis-body">
                Supporting breakdowns
            </button>
        </h2>
        <div id="supporting-analysis-body" class="accordion-collapse collapse" aria-labelledby="supporting-analysis-heading">
            <div class="accordion-body">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <h3 class="h5">Categories</h3>
                        <table class="table table-sm">
                            @foreach (var category in Model.Summary.ByCategory.OrderByDescending(x => x.Value.TotalSpent))
                            {
                                <tr><td>@category.Key</td><td class="text-end">@category.Value.TotalSpent.ToString("C")</td></tr>
                            }
                        </table>
                    </div>
                    <div class="col-lg-6">
                        <h3 class="h5">Top merchants</h3>
                        <table class="table table-sm">
                            @foreach (var merchant in Model.Summary.ByMerchant.OrderByDescending(x => x.Value.TotalSpent).Take(10))
                            {
                                <tr><td>@merchant.Key</td><td class="text-end">@merchant.Value.TotalSpent.ToString("C")</td></tr>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-5">
    <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#raw-data-table" aria-expanded="false" aria-controls="raw-data-table">
        Show raw data
    </button>

    <div class="collapse mt-3" id="raw-data-table">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Transaction Date</th>
                    <th>Posted Date</th>
                    <th>Description</th>
                    <th>Original Category</th>
                    <th>Custom Category</th>
                    <th>Debit</th>
                    <th>Credit</th>
                    <th>Net Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in Model.Transactions)
                {
                    <tr>
                        <td>@transaction.TransactionDate.ToShortDateString()</td>
                        <td>@transaction.PostedDate.ToShortDateString()</td>
                        <td>@transaction.Description</td>
                        <td>@transaction.Category</td>
                        <td>@transaction.EffectiveCategory</td>
                        <td>@transaction.Debit.ToString("C")</td>
                        <td>@transaction.Credit.ToString("C")</td>
                        <td style="color: @(transaction.NetAmount >= 0 ? "green" : "red")">
                            @transaction.NetAmount.ToString("C")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="transaction-detail" aria-labelledby="transaction-detail-title">
    <div class="offcanvas-header">
        <div>
            <p class="eyebrow mb-1">Transaction detail</p>
            <h2 class="offcanvas-title" id="transaction-detail-title">Transaction detail</h2>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="detail-total mb-4">
            <span id="transaction-detail-count">0 transactions</span>
            <strong id="transaction-detail-total">$0.00</strong>
        </div>
        <div id="transaction-detail-list" class="detail-list"></div>
    </div>
</div>

<script id="transaction-detail-data" type="application/json">@Html.Raw(JsonSerializer.Serialize(detailTransactions))</script>
