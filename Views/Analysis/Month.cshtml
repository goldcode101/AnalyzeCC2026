@using System.Globalization
@model CreditCardAnalyzer.Models.MonthlySummaryViewModel

@{
    var monthDate = DateTime.ParseExact(Model.MonthKey, "yyyy-MM", CultureInfo.InvariantCulture);
    var monthName = monthDate.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    var totalDebits = Model.Transactions.Sum(transaction => transaction.Debit);
    var categoryGroups = Model.Categories
        .OrderByDescending(category => category.Value.TotalSpent)
        .ToList();
}

<div class="analysis-heading">
    <div>
        <p class="eyebrow mb-1">Monthly summary</p>
        <h1 class="mb-0">@monthName</h1>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Analysis" asp-action="Index">All analysis</a>
</div>

<div class="headline-strip mb-4">
    <div>
        <span>Net spending</span>
        <strong>@Model.Spending.TotalSpent.ToString("C")</strong>
    </div>
    <div>
        <span>Charges</span>
        <strong>@totalDebits.ToString("C")</strong>
    </div>
    <div>
        <span>Credits applied</span>
        <strong>@Model.QualifyingCredits.ToString("C")</strong>
    </div>
    <div>
        <span>Card payments excluded</span>
        <strong>@Model.ExcludedCredits.ToString("C")</strong>
    </div>
</div>

<section class="analysis-section mb-4">
    <div class="section-heading">
        <div>
            <p class="eyebrow mb-1">Category breakdown</p>
            <h2>Where the money went</h2>
        </div>
        <span class="text-muted small">Refunds reduce net spending</span>
    </div>

    @if (categoryGroups.Count == 0)
    {
        <p class="text-muted mb-0">No spending categories were recorded for this month.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table analysis-matrix mb-0">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th class="text-end">Transactions</th>
                        <th class="text-end">Net spending</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in categoryGroups)
                    {
                        <tr>
                            <th>@category.Key</th>
                            <td class="text-end">@category.Value.Count</td>
                            <td class="text-end">@category.Value.TotalSpent.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="analysis-section">
    <div class="section-heading">
        <div>
            <p class="eyebrow mb-1">Transaction activity</p>
            <h2>All activity in @monthName</h2>
        </div>
        <span class="text-muted small">Includes card payments and credits</span>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered mb-0">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th class="text-end">Debit</th>
                    <th class="text-end">Credit</th>
                    <th class="text-end">Net</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in Model.Transactions.OrderByDescending(transaction => transaction.TransactionDate))
                {
                    <tr>
                        <td>@transaction.TransactionDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</td>
                        <td>@transaction.Description</td>
                        <td>@transaction.EffectiveCategory</td>
                        <td class="text-end">@transaction.Debit.ToString("C")</td>
                        <td class="text-end">@transaction.Credit.ToString("C")</td>
                        <td class="text-end">@transaction.NetAmount.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
